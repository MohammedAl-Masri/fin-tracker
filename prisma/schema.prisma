generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id Int @id @default(autoincrement())
  name String
  email String @unique
  password String

  salaries Salary[]
  expenses  Expense[]
}
model Salary{
  id Int @id @default(autoincrement())
  date DateTime @default(now())
  amount Int
  userId Int

  user User @relation(fields:[userId], references:[id])
}
model Expense{
  id Int @id @default(autoincrement())
  date DateTime @default(now())
  amount Int
  userId Int
  type String

  user User @relation(fields:[userId], references:[id])
}
